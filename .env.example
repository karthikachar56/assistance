# ==============================================================================
# Voice Khata Environment Configuration
# Copy this file to .env and fill in your API keys. NEVER commit .env to git.
# ==============================================================================

# --- Gemini AI (Primary Intelligence, Audio Understanding, Live API & TTS) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_FAST_MODEL=gemini-3.8-flash
GEMINI_PRO_MODEL=gemini-4-argon
GEMINI_CARBON_MODEL=gemini-4-carbon
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
GEMINI_VOICE_NAME=Puck

# --- Gnani AI Platform (Optional Hackathon Speech Adapter: Prisma STT & Timbre TTS) ---
# When GNANI_API_KEY is set and SPEECH_PROVIDER=gnani (or auto), Prisma/Timbre are used.
GNANI_API_KEY=
GNANI_STT_MODEL=prisma-v3.0
GNANI_TTS_MODEL=timbre-v3.0
GNANI_TTS_VOICE=Nalini

# --- Provider & Optimization Controls ---
# SPEECH_PROVIDER: auto | gemini | gnani | browser
SPEECH_PROVIDER=auto
# AI_MODE: cascaded (fast-path + 3.8-flash + 4-argon escalation) | flash | argon | carbon | offline
AI_MODE=cascaded
ESCALATION_CONFIDENCE_THRESHOLD=0.80

# --- Security & DPDP Act Compliance ---
# 32-byte URL-safe base64 or hex key for AES-256-GCM encryption at rest.
# Leave blank in local dev to auto-generate a local gitignored .ledger.key.
LEDGER_ENCRYPTION_KEY=
EPHEMERAL_TRANSCRIPTS=false
DATABASE_PATH=backend/data/voice_khata.db
# Optional MongoDB connection string (local mongodb://... or Atlas mongodb+srv://...).
# Leave blank to use the default encrypted local SQLite database.
MONGODB_URL=
MONGODB_DB_NAME=voice_khata

# --- Server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

